#version 430 core

#include "common.glsl"

// Forward declarations
vec2 intersectAABB(vec3 ro, vec3 invRd, vec3 bMin, vec3 bMax);
HitInfo sphereTrace(vec3 ro, vec3 rd, float tMin, float tMax, int nodeIdx);
HitInfo traceBVH(vec3 ro, vec3 rd);
vec3 getCameraRay(vec2 uv);
vec3 fastPBR(vec3 pos, vec3 rd, vec3 normal, int objID);

#include "sdf.glsl"
#include "mapping.glsl"
#include "lighting.glsl"

// Optimized AABB intersection using precomputed inverse ray direction
vec2 intersectAABB(vec3 ro, vec3 invRd, vec3 bMin, vec3 bMax) {
    vec3 t0 = (bMin - ro) * invRd;
    vec3 t1 = (bMax - ro) * invRd;

    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    float tNear = max(max(tMin.x, tMin.y), tMin.z);
    float tFar = min(min(tMax.x, tMax.y), tMax.z);

    return vec2(tNear, tFar);
}

HitInfo sphereTrace(vec3 ro, vec3 rd, float tMin, float tMax, int nodeIdx) {
    float t = tMin;
    HitInfo hit;
    hit.distance = -1.0;
    hit.objectID = -1;

    BVHNode node = nodes[nodeIdx];
    int start = node.child.z;
    int count = node.child.w;

    for(int i = 0; i < MAX_STEPS; ++i) {
        vec3 pos = ro + rd * t;
        vec2 distId = calcSDFWithID(pos, start, count);
        float d = distId.x;

        if(d < MIN_DIST_TO_SDF) {
            hit.distance = t;
            hit.objectID = int(distId.y);
            return hit;
        }
        if(t > tMax) break;

        float stepMult = 0.7;
        if(d < 0.1) stepMult = 0.5;

        t += d * stepMult;
    }

    return hit;
}

// Highly optimized BVH traversal
HitInfo traceBVH(vec3 ro, vec3 rd) {
    // Precompute inverse ray direction for all AABB tests
    vec3 invRd = 1.0 / (rd + vec3(1e-6) * sign(rd));

    float closestHit = MAX_DIST_TO_TRAVEL;
    int hitObjID = -1;

    // Stack-based traversal with early termination
    int stack[32]; // Reduced stack size for better performance
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while(stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];

        if(nodeIdx >= nodes.length()) continue;

        BVHNode node = nodes[nodeIdx];
        vec2 tBox = intersectAABB(ro, invRd, node.boundsMin.xyz, node.boundsMax.xyz);

        // Early rejection
        if(tBox.x > tBox.y || tBox.y < 0.0 || tBox.x >= closestHit) continue;

        if(node.child.x < 0) {
            // Leaf node - sphere trace
            float tStart = max(tBox.x, 0.001);
            float tEnd = min(tBox.y, closestHit);

            if(tStart < tEnd) {
                HitInfo traceResult = sphereTrace(ro, rd, tStart, tEnd, nodeIdx);
                if(traceResult.distance > 0.0 && traceResult.distance < closestHit) {
                    closestHit = traceResult.distance;
                    hitObjID = traceResult.objectID;
                }
            }
        } else {
            // Internal node - add children to stack
            int leftChild = node.child.x;
            int rightChild = node.child.y;

            if(leftChild < nodes.length() && rightChild < nodes.length() && stackPtr < 30) {
                // Test both children and add in distance order
                BVHNode leftNode = nodes[leftChild];
                BVHNode rightNode = nodes[rightChild];

                vec2 leftBox = intersectAABB(ro, invRd, leftNode.boundsMin.xyz, leftNode.boundsMax.xyz);
                vec2 rightBox = intersectAABB(ro, invRd, rightNode.boundsMin.xyz, rightNode.boundsMax.xyz);

                bool leftValid = leftBox.x <= leftBox.y && leftBox.y >= 0.0 && leftBox.x < closestHit;
                bool rightValid = rightBox.x <= rightBox.y && rightBox.y >= 0.0 && rightBox.x < closestHit;

                // Add further child first (for near-to-far traversal)
                if(leftValid && rightValid) {
                    if(leftBox.x > rightBox.x) {
                        stack[stackPtr++] = leftChild;
                        stack[stackPtr++] = rightChild;
                    } else {
                        stack[stackPtr++] = rightChild;
                        stack[stackPtr++] = leftChild;
                    }
                } else if(leftValid) {
                    stack[stackPtr++] = leftChild;
                } else if(rightValid) {
                    stack[stackPtr++] = rightChild;
                }
            }
        }
    }

    HitInfo hit;
    hit.distance = closestHit;
    hit.objectID = hitObjID;

    return hit;
}

// Optimized camera ray generation
vec3 getCameraRay(vec2 uv) {
    vec3 forward = normalize(u_camTarget);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);

    float zoom = (u_scroll * 0.05) + 0.5;
    zoom = max(zoom, 0.5);

    return normalize(forward * zoom + uv.x * right + uv.y * up);
}

// Optimized fog calculation
vec3 applyFog(vec3 color, float dist) {
    float fogFactor = exp(-dist * 0.00008);
    vec3 fogColor = vec3(0.7, 0.8, 0.9);
    return mix(fogColor, color, fogFactor);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(pixel) / u_resolution.xy) * 2.0 - 1.0;
    uv.x *= u_resolution.x / u_resolution.y;

    vec3 rd = getCameraRay(uv);
    vec3 ro = u_camPos;

    // Primary ray
    HitInfo hit = traceBVH(ro, rd);
    float t = hit.distance;
    vec3 color;

    if(t < MAX_DIST_TO_TRAVEL) {
        vec3 pos = ro + rd * t;
        vec4 normalData = getNormal(pos);
        vec3 normal = normalData.xyz;
        int objID = int(normalData.w);

        // Fast PBR shading
        color = fastPBR(pos, rd, normal, objID);

        // Reflection if enabled
        if(REFLECTIONS) {
            Object obj = allObjects[objID];
            vec2 uv = pos.xy * obj.textureScale; // Simplified UV

            float metallic = DEFAULTMETALLIC;
            float roughness = DEFAULTROUGHNESS;
            if (obj.metallicID >= 0) {
                metallic = texture(textureArray, vec3(uv, obj.metallicID)).r;
            }
            if (obj.roughnessID >= 0) {
                roughness = texture(textureArray, vec3(uv, obj.roughnessID)).r;
            }

            vec3 reflColor = getReflection(pos, rd, normal, metallic, roughness);
            float reflStrength = REFLECTIONSTRENGTH * metallic * (1.0 - roughness * 0.5);
            color = mix(color, reflColor, reflStrength);
        }

        // Apply fog
        color = applyFog(color, t);
    } else {
        // Sky
        color = vec3(0.6, 0.7, 0.9);
    }

    // Simple gamma correction
    color = pow(color, vec3(0.45));

    imageStore(resultImage, pixel, vec4(color, 1.0));
}