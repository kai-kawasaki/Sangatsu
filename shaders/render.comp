layout (local_size_x = 8, local_size_y = 8) in;
layout (binding = 0, rgba32f) uniform writeonly image2D resultImage;

#define DEFAULTROUGHNESS 0.9
#define DEFAULTMETALLIC 0.1

// Optimized AABB intersection using precomputed inverse ray direction
vec2 intersectAABB(vec3 ro, vec3 invRd, vec3 bMin, vec3 bMax) {
    vec3 t0 = (bMin - ro) * invRd;
    vec3 t1 = (bMax - ro) * invRd;

    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    float tNear = max(max(tMin.x, tMin.y), tMin.z);
    float tFar = min(min(tMax.x, tMax.y), tMax.z);

    return vec2(tNear, tFar);
}

float sphereTrace(vec3 ro, vec3 rd, float tMin, float tMax, int nodeIdx) {
    float t = tMin;

        BVHNode node = nodes[nodeIdx];
        int start = node.child.z;
        int count = node.child.w;

    for(int i = 0; i < MAX_STEPS; ++i) {
        vec3 pos = ro + rd * t;
        float d = calcSDF(pos, start, count);

        if(d < MIN_DIST_TO_SDF) return t;
        if(t > tMax) break;

        // More conservative stepping for displaced surfaces
        float stepMult = 0.7; // Even more conservative

        // If we're close to surface, be extra careful
        if(d < 0.1) stepMult = 0.5;

        t += d * stepMult;
    }

    return -1.0;
}

// Highly optimized BVH traversal
HitInfo traceBVH(vec3 ro, vec3 rd) {
    // Precompute inverse ray direction for all AABB tests
    vec3 invRd = 1.0 / (rd + vec3(1e-6) * sign(rd));

    float closestHit = MAX_DIST_TO_TRAVEL;
    int hitObjID = -1;

    // Stack-based traversal with early termination
    int stack[32]; // Reduced stack size for better performance
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while(stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];

        if(nodeIdx >= nodes.length()) continue;

        BVHNode node = nodes[nodeIdx];
        vec2 tBox = intersectAABB(ro, invRd, node.boundsMin.xyz, node.boundsMax.xyz);

        // Early rejection
        if(tBox.x > tBox.y || tBox.y < 0.0 || tBox.x >= closestHit) continue;

        if(node.child.x < 0) {
            // Leaf node - sphere trace
            float tStart = max(tBox.x, 0.001);
            float tEnd = min(tBox.y, closestHit);

            if(tStart < tEnd) {
                float hit = sphereTrace(ro, rd, tStart, tEnd, nodeIdx);
                if(hit > 0.0 && hit < closestHit) {
                    closestHit = hit;
                    hitObjID = objectIndices[nodeIdx];
                }
            }
        } else {
            // Internal node - add children to stack
            int leftChild = node.child.x;
            int rightChild = node.child.y;

            if(leftChild < nodes.length() && rightChild < nodes.length() && stackPtr < 30) {
                // Test both children and add in distance order
                BVHNode leftNode = nodes[leftChild];
                BVHNode rightNode = nodes[rightChild];

                vec2 leftBox = intersectAABB(ro, invRd, leftNode.boundsMin.xyz, leftNode.boundsMax.xyz);
                vec2 rightBox = intersectAABB(ro, invRd, rightNode.boundsMin.xyz, rightNode.boundsMax.xyz);

                bool leftValid = leftBox.x <= leftBox.y && leftBox.y >= 0.0 && leftBox.x < closestHit;
                bool rightValid = rightBox.x <= rightBox.y && rightBox.y >= 0.0 && rightBox.x < closestHit;

                // Add further child first (for near-to-far traversal)
                if(leftValid && rightValid) {
                    if(leftBox.x > rightBox.x) {
                        stack[stackPtr++] = leftChild;
                        stack[stackPtr++] = rightChild;
                    } else {
                        stack[stackPtr++] = rightChild;
                        stack[stackPtr++] = leftChild;
                    }
                } else if(leftValid) {
                    stack[stackPtr++] = leftChild;
                } else if(rightValid) {
                    stack[stackPtr++] = rightChild;
                }
            }
        }
    }

    HitInfo hit;
    hit.distance = closestHit;
    hit.objectID = hitObjID;

    return hit;
}

// Optimized camera ray generation
vec3 getCameraRay(vec2 uv) {
    vec3 forward = normalize(u_camTarget);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);

    float zoom = (u_scroll * 0.05) + 0.5;
    zoom = max(zoom, 0.5);

    return normalize(forward * zoom + uv.x * right + uv.y * up);
}

// Fast stylized PBR shading with improved triplanar mapping
vec3 fastPBR(vec3 pos, vec3 rd, vec3 normal, int objID) {
    Object obj = allObjects[objID];

    // Get object properties
    vec3 baseColor = vec3(obj.r, obj.g, obj.b);
    float baseRoughness = 0.8;
    float baseMetallic = 0.2;

    // Improved triplanar mapping with better blending
    vec3 absN = abs(normal);

    // Detect edges for adaptive blending power
    float edgeFactor = max(max(absN.x, absN.y), absN.z) - min(min(absN.x, absN.y), absN.z);
    float blendPower = mix(3.0, 5.0, edgeFactor);

    // Calculate blend weights
    vec3 weights = pow(absN, vec3(blendPower));
    weights /= (weights.x + weights.y + weights.z);

    // Get texture coordinates for each axis
    vec3 pp = pos * obj.textureScale;
    vec2 uvX = fract(pp.yz * 0.5 + 0.5); // X-axis
    vec2 uvY = fract(pp.xz * 0.5 + 0.5); // Y-axis
    vec2 uvZ = fract(pp.xy * 0.5 + 0.5); // Z-axis

    // Material properties
    vec3 albedo = baseColor;
    float roughness = baseRoughness;
    float metallic = baseMetallic;
    float ao = 1.0;

    // Sample textures if available
    if (obj.albedoID >= 0) {
        vec3 texX = texture(textureArray, vec3(uvX, obj.albedoID)).rgb;
        vec3 texY = texture(textureArray, vec3(uvY, obj.albedoID)).rgb;
        vec3 texZ = texture(textureArray, vec3(uvZ, obj.albedoID)).rgb;
        albedo = texX * weights.x + texY * weights.y + texZ * weights.z;
    }

    if (obj.roughnessID >= 0) {
        float rX = texture(textureArray, vec3(uvX, obj.roughnessID)).r;
        float rY = texture(textureArray, vec3(uvY, obj.roughnessID)).r;
        float rZ = texture(textureArray, vec3(uvZ, obj.roughnessID)).r;
        roughness = rX * weights.x + rY * weights.y + rZ * weights.z;
    }

    if (obj.metallicID >= 0) {
        float mX = texture(textureArray, vec3(uvX, obj.metallicID)).r;
        float mY = texture(textureArray, vec3(uvY, obj.metallicID)).r;
        float mZ = texture(textureArray, vec3(uvZ, obj.metallicID)).r;
        metallic = mX * weights.x + mY * weights.y + mZ * weights.z;
    }

    if (obj.aoID >= 0) {
        float aoX = texture(textureArray, vec3(uvX, obj.aoID)).r;
        float aoY = texture(textureArray, vec3(uvY, obj.aoID)).r;
        float aoZ = texture(textureArray, vec3(uvZ, obj.aoID)).r;
        ao = aoX * weights.x + aoY * weights.y + aoZ * weights.z;
    }

    // Save original normal for shadow calculation
    vec3 shadowTestNormal = normal;

    // Apply normal mapping if available
    if (obj.normalID >= 0) {
        // For normal mapping, we need tangent space
        vec3 upVector = abs(normal.y) > 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 tangent = normalize(cross(normal, upVector));
        vec3 bitangent = normalize(cross(normal, tangent));
        mat3 TBN = mat3(tangent, bitangent, normal);

        // Get normal maps for each plane
        vec3 nmX = texture(textureArray, vec3(uvX, obj.normalID)).rgb * 2.0 - 1.0;
        vec3 nmY = texture(textureArray, vec3(uvY, obj.normalID)).rgb * 2.0 - 1.0;
        vec3 nmZ = texture(textureArray, vec3(uvZ, obj.normalID)).rgb * 2.0 - 1.0;

        // Blend normal maps and transform to world space
        vec3 blendedNormalMap = normalize(
        nmX * weights.x +
        nmY * weights.y +
        nmZ * weights.z
        );

        normal = normalize(TBN * blendedNormalMap);
    }

    // Lighting calculation
    vec3 lightDir = normalize(u_lightPos - pos);
    float NdotL = max(dot(normal, lightDir), 0.0);

    // Shadow calculation - using original geometric normal for offset
    float shadowBias = 0.02;
    float dist = traceBVH(pos + shadowTestNormal * shadowBias, lightDir).distance;
    float shadow = 1.0;

    if (dist < MAX_DIST_TO_TRAVEL) {
        shadow = 0.0;
    }

    // Apply shadow to lighting
    NdotL *= shadow;

    // PBR lighting
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 diffuse = albedo * (1.0 - metallic) * NdotL;

    // Specular reflection
    vec3 viewDir = -rd;
    vec3 halfDir = normalize(lightDir + viewDir);
    float NdotH = max(dot(normal, halfDir), 0.0);

    // Specular power based on roughness
    float specPower = 2.0 / (roughness * roughness + 0.01) - 2.0;
    vec3 specular = F0 * pow(NdotH, specPower) * NdotL;

    // Apply ambient occlusion
    diffuse *= ao;
    specular *= ao;

    // Ambient lighting with environment influence
    vec3 ambient = albedo * 0.1 * ao;

    // Combine lighting components
    return ambient + diffuse + specular;
}

// Simple stylized reflection
vec3 getReflection(vec3 pos, vec3 rd, vec3 normal, float metallic, float roughness) {
    if(metallic < 0.1) return vec3(0.0);

    vec3 reflDir = reflect(rd, normal);

    // Add roughness perturbation
    if(roughness > 0.01) {
        vec3 noise = fract(sin(pos * 12.345) * 43758.5453) - 0.5;
        reflDir = normalize(reflDir + noise * roughness * 0.3);
    }

    HitInfo hit = traceBVH(pos + normal * 0.01, reflDir);
    float reflDist = hit.distance;

    if(reflDist < MAX_DIST_TO_TRAVEL) {
        vec3 reflPos = pos + normal * 0.01 + reflDir * reflDist;
        vec4 reflNormalData = getNormal(reflPos);
        vec3 reflNormal = reflNormalData.xyz;
        int reflObjID = int(reflNormalData.w);
//        vec3 reflNormal = getPrimitiveNormal(allObjects[hit.objectID], reflPos);
//        int reflObjID = hit.objectID;

        return fastPBR(reflPos, reflDir, reflNormal, reflObjID);
    }

    // Sky color for missed reflections
    return vec3(0.6, 0.7, 0.9);
}

// Optimized fog calculation
vec3 applyFog(vec3 color, float dist) {
    float fogFactor = exp(-dist * 0.00008);
    vec3 fogColor = vec3(0.7, 0.8, 0.9);
    return mix(fogColor, color, fogFactor);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(pixel) / u_resolution.xy) * 2.0 - 1.0;
    uv.x *= u_resolution.x / u_resolution.y;

    vec3 rd = getCameraRay(uv);
    vec3 ro = u_camPos;

    // Primary ray
    HitInfo hit = traceBVH(ro, rd);
    float t = hit.distance;
    vec3 color;

    if(t < MAX_DIST_TO_TRAVEL) {
        vec3 pos = ro + rd * t;
        vec4 normalData = getNormal(pos);
        vec3 normal = normalData.xyz;
        int objID = int(normalData.w);

//        vec3 normal = getPrimitiveNormal(allObjects[hit.objectID], pos);
//        int objID = hit.objectID;

        // Fast PBR shading
        color = fastPBR(pos, rd, normal, objID);

        // Reflection if enabled
        if(REFLECTIONS) {
            Object obj = allObjects[objID];
            vec2 uv = pos.xy * obj.textureScale; // Simplified UV

            float metallic = DEFAULTMETALLIC;
            float roughness = DEFAULTROUGHNESS;
            if (obj.metallicID >= 0) {
                metallic = texture(textureArray, vec3(uv, obj.metallicID)).r;
            }
            if (obj.roughnessID >= 0) {
                roughness = texture(textureArray, vec3(uv, obj.roughnessID)).r;
            }

            vec3 reflColor = getReflection(pos, rd, normal, metallic, roughness);
            float reflStrength = REFLECTIONSTRENGTH * metallic * (1.0 - roughness * 0.5);
            color = mix(color, reflColor, reflStrength);
        }

        // Apply fog
        color = applyFog(color, t);
    } else {
        // Sky
        color = vec3(0.6, 0.7, 0.9);
    }

    // Simple gamma correction
    color = pow(color, vec3(0.45));

    imageStore(resultImage, pixel, vec4(color, 1.0));
}